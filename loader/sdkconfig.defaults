# esprack-loader: small and quiet. Wi-Fi station + AP, an HTTP server, a
# plain-HTTP download on sockets, NVS, OTA, SHA-256 and ECDSA P-256;
# nothing else (no TLS, no IPv6, no Bluetooth: not in the build at all).

# Size
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n
CONFIG_HAL_DEFAULT_ASSERTION_LEVEL=0
CONFIG_LWIP_ESP_LWIP_ASSERT=n

# Logging: warnings (the loader's own info lines: main/CMakeLists.txt)
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# Network
CONFIG_LWIP_IPV6=n

# Wi-Fi: WPA/WPA2 personal, station and AP
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_NAN_ENABLE=n
CONFIG_ESP_WIFI_GMAC_SUPPORT=n
CONFIG_ESP_WIFI_GCMP_SUPPORT=n
CONFIG_ESP_WIFI_WAPI_PSK=n
CONFIG_ESP_WIFI_DPP_SUPPORT=n
CONFIG_ESP_WIFI_11KV_SUPPORT=n
CONFIG_ESP_WIFI_MBO_SUPPORT=n
CONFIG_ESP_WIFI_FTM_ENABLE=n
CONFIG_ESP_WIFI_ENABLE_ROAMING_APP=n
CONFIG_ESP_WIFI_ENABLE_WIFI_TX_STATS=n
CONFIG_ESP_WIFI_ENABLE_WIFI_RX_STATS=n
# PHY calibration each boot: the loader writes no PHY data into the app's NVS
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n

# mbedtls: P-256 only (the image signature; WPA2 needs no curve)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=n

# HTTP server: a browser on the app's address sends the app's cookies too
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_WS_SUPPORT=n

# Tasks
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# OTA: the loader boots ota_0; no rollback in this scheme
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n
CONFIG_PARTITION_TABLE_CUSTOM=y

# This project's bootloader (written only with a boot button pin,
# CMakeLists.txt) behaves as Arduino's: no image check on a deep-sleep
# wake, and so the same 16-byte RTC record at the top of RTC fast memory
# (BOOTLOADER_RESERVE_RTC_MEM, as the Arduino libs reserve it).
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y

# Flash mode and frequency per chip: sdkconfig.defaults.<target> (the
# Arduino boards' bootloaders), else CMakeLists.txt's LOADER_FLASH_*.
